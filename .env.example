# SIMAORKA Backend Environment Configuration
# Copy this file to .env and fill in your values

# Django Core
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/simaorka

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Options: 'local', 's3', 'supabase'
STORAGE_BACKEND=local

# --- Supabase Storage (Recommended) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=simaorka

# --- S3/MinIO Storage (Alternative) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=simaorka
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# ===========================================
# AUTHENTICATION
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Settings (optional, defaults work fine)
# JWT_ACCESS_TOKEN_LIFETIME=3600
# JWT_REFRESH_TOKEN_LIFETIME=604800

# ===========================================
# WEB3 CONFIGURATION (Optional Feature)
# ===========================================
# Set to True to enable Web3 features
WEB3_ENABLED=False
WEB3_CHAIN=sepolia
WEB3_CHAIN_ID=11155111

# RPC Provider (Infura/Alchemy/QuickNode)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# Smart Contract Addresses (after deployment via Remix)
# See: contracts/README.md for deployment instructions
ROLE_NFT_ADDRESS=0x...
GOV_TOKEN_ADDRESS=0x...
DUES_CONTRACT_ADDRESS=0x...

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Backend: console (dev), smtp (prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIMAORKA <noreply@simaorka.id>

# Frontend URL (for email links like password reset)
FRONTEND_URL=http://localhost:3000
